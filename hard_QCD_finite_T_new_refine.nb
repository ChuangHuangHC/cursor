Cell[BoxData[
 RowBox[{
  RowBox[{"paraRepl", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"gluon", " ", "prop"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"RA", "[", "q", "]"}], "->", "RAxq"}], ",", 
     RowBox[{
      RowBox[{"dRA", "[", "q", "]"}], "->", "dRAxq"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RA", "[", 
       RowBox[{
        RowBox[{"-", "p"}], "+", "q"}], "]"}], "->", "RAxpMq"}], ",", 
     RowBox[{
      RowBox[{"dRA", "[", 
       RowBox[{
        RowBox[{"-", "p"}], "+", "q"}], "]"}], "->", "dRAxpMq"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RA", "[", 
       RowBox[{
        RowBox[{"-", "pf"}], "+", "qf"}], "]"}], "->", "RAxpfMqf"}], ",", 
     RowBox[{
      RowBox[{"dRA", "[", 
       RowBox[{
        RowBox[{"-", "pf"}], "+", "qf"}], "]"}], "->", "dRAxpfMqf"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RA", "[", 
       RowBox[{"p1", "+", "q"}], "]"}], "->", "RAxp1Pq"}], ",", 
     RowBox[{
      RowBox[{"RA", "[", 
       RowBox[{
        RowBox[{"-", "p1"}], "+", "q"}], "]"}], "->", "RAxp1Mq"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RA", "[", 
       RowBox[{
        RowBox[{"-", "p2"}], "+", "q"}], "]"}], "->", "RAxp2Mq"}], ",", 
     RowBox[{
      RowBox[{"RA", "[", 
       RowBox[{"p2", "-", "q"}], "]"}], "->", "RAxp2Mq"}], ",", 
