Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"momentum", "[", "p1_", "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"innerProductRepl", "[", 
        RowBox[{
         RowBox[{"sp", "[", 
          RowBox[{"p1", ",", "p1"}], "]"}], "+", 
         RowBox[{"kcoef", " ", 
          SuperscriptBox["k", "2"]}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"symmetricMomentum", "[", 
      RowBox[{"q1_", ",", "q2_", ",", "q3_"}], "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "3"], 
         RowBox[{"innerProductRepl", "[", 
          RowBox[{
           RowBox[{"sp", "[", 
            RowBox[{"q1", ",", "q1"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"q2", ",", "q2"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"q3", ",", "q3"}], "]"}]}], "]"}]}], "+", 
        RowBox[{"kcoef", " ", 
         SuperscriptBox["k", "2"]}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"symmetricMomentum4", "[", 
      RowBox[{"q1_", ",", "q2_", ",", "q3_", ",", "q4_"}], "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "4"], 
         RowBox[{"innerProductRepl", "[", 
          RowBox[{
           RowBox[{"sp", "[", 
            RowBox[{"q1", ",", "q1"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"q2", ",", "q2"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"q3", ",", "q3"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"q4", ",", "q4"}], "]"}]}], "]"}]}], "+", 
        RowBox[{"kcoef", " ", 
         SuperscriptBox["k", "2"]}]}], "]"}], "]"}]}], ";"}]}], 
  "*)"}]], "Input",
