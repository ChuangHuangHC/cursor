               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NRc", "->", "3"}], ",", 
                 RowBox[{"NRf", "->", "2"}]}], "}"}]}], "]"}], "//", 
             "UltraSimplify"}], ")"}], "//.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q1", "->", 
