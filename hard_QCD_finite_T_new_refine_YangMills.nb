  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"timing", ",", "result", ",", "varName"}], "}"}], ",", 
      RowBox[{
       RowBox[{"varName", "=", 
        RowBox[{"\"\<dlambdaqqA1flow3for\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"{", 
         RowBox[{"timing", ",", "result"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"innerProductReplaaa", "[", 
              RowBox[{
               RowBox[{"FormTrace", "[", 
                RowBox[{
                 RowBox[{"sliceAlgExpr", "[", 
                  RowBox[{"dlambdaqqA13", ",", "quarkGluonCoeffi3"}], "]"}], 
