Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"timing", ",", "result", ",", "varName"}], "}"}], ",", 
      RowBox[{
       RowBox[{"varName", "=", 
        RowBox[{"\"\<dlambdaqqA7flow2for\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"{", 
         RowBox[{"timing", ",", "result"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"innerProductReplaaa", "[", 
              RowBox[{
               RowBox[{"FormTrace", "[", 
                RowBox[{
                 RowBox[{"sliceAlgExpr", "[", 
                  RowBox[{"dlambdaqqA72", ",", "quarkGluonCoeffi2"}], "]"}], 
                 "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NRc", "->", "3"}], ",", 
                 RowBox[{"NRf", "->", "2"}]}], "}"}]}], "]"}], "//", 
             "UltraSimplify"}], ")"}], "//.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q1", "->", 
              RowBox[{"q", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
             RowBox[{"q2", "->", 
              RowBox[{"q", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], "//", 
          "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "=", 
           RowBox[{"Symbol", "[", "varName", "]"}]}], "}"}], ",", 
         RowBox[{"s", "=", "result"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "varName", ",", "\"\< \:8dd1\:5b8c\:4e86\:ff0c\:7528\:65f6 \>\"", ",",
          "timing", ",", "\"\< s\>\""}], "]"}], ";"}]}], "]"}], ",", 
