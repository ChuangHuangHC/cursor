Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"timing", ",", "result", ",", "varName"}], "}"}], ",", 
      RowBox[{
       RowBox[{"varName", "=", 
        RowBox[{"\"\<dlambdaqqA1flow6for\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"{", 
         RowBox[{"timing", ",", "result"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"innerProductReplaaa", "[", 
              RowBox[{
               RowBox[{"FormTrace", "[", 
                RowBox[{
                 RowBox[{"sliceAlgExpr", "[", 
                  RowBox[{"dlambdaqqA16", ",", "quarkGluonCoeffi6"}], "]"}], 
                 "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NRc", "->", "3"}], ",", 
                 RowBox[{"NRf", "->", "2"}]}], "}"}]}], "]"}], "//", 
             "UltraSimplify"}], ")"}], "//.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q1", "->", 
              RowBox[{"q", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
             RowBox[{"q2", "->", 
              RowBox[{"q", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
