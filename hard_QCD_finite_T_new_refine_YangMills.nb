          "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"varName", ",", "InputForm", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"sym", ",", 
           RowBox[{"sym", "=", "result"}], ",", "HoldAllComplete"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
