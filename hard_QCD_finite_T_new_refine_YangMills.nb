Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"timing", ",", "result", ",", "varName"}], "}"}], ",", 
      RowBox[{
       RowBox[{"varName", "=", 
        RowBox[{"\"\<dlambdaqqA7flow5for\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"{", 
         RowBox[{"timing", ",", "result"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"innerProductReplaaa", "[", 
              RowBox[{
               RowBox[{"FormTrace", "[", 
                RowBox[{
                 RowBox[{"sliceAlgExpr", "[", 
                  RowBox[{"dlambdaqqA75", ",", "quarkGluonCoeffi5"}], "]"}], 
                 "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NRc", "->", "3"}], ",", 
                 RowBox[{"NRf", "->", "2"}]}], "}"}]}], "]"}], "//", 
             "UltraSimplify"}], ")"}], "//.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q1", "->", 
              RowBox[{"q", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
             RowBox[{"q2", "->", 
              RowBox[{"q", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], "//", 
          "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"varName", ",", "InputForm", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"sym", ",", 
           RowBox[{"sym", "=", "result"}], ",", "HoldAllComplete"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "varName", ",", "\"\< \:8dd1\:5b8c\:4e86\:ff0c\:7528\:65f6 \>\"", ",",
          "timing", ",", "\"\< s\>\""}], "]"}], ";"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "9"}], "}"}]}], "]"}], ";"}]], "Input",
