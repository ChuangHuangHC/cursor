              RowBox[{"q", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], "//", 
          "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "=", 
           RowBox[{"Symbol", "[", "varName", "]"}]}], "}"}], ",", 
         RowBox[{"s", "=", "result"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
